# ─── Discord ──────────────────────────────────────────────────────────────────
# Required: Create an application at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ─── Security ─────────────────────────────────────────────────────────────────
# Required: Change this to a long random string (e.g. run: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_long_random_string

# ─── Database ─────────────────────────────────────────────────────────────────
# Optional: Change from the default password
POSTGRES_PASSWORD=harmonia_secret

# ─── Lavalink (audio server) ─────────────────────────────────────────────────
# Optional: Change to match lavalink/application.yml server.password
LAVALINK_PASSWORD=youshallnotpass

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Optional: Port on your host to expose the dashboard (default 3000)
DASHBOARD_PORT=3000
